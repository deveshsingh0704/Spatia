# LatentCraft Environment Configuration
# ======================================

# Database Configuration (PostgreSQL / SQLite fallback)
# Set your PostgreSQL connection string here. If the PostgreSQL container is running,
# LatentCraft will connect automatically via asyncpg. If unreachable, it safely falls back to local SQLite.
# Example: postgresql+asyncpg://postgres:postgres@localhost:5433/latentcraft
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/latentcraft

# JWT Authentication
JWT_SECRET_KEY=latentcraft_spatial_diffusion_jwt_secret_key_2026_deterministic
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloud Storage Configuration (AWS S3 / Cloudflare R2 / MinIO)
# Leave empty to automatically use local storage under server/outputs/gallery/
# When you add cloud credentials in the future, LatentCraft will automatically upload images there.
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_CUSTOM_DOMAIN=

