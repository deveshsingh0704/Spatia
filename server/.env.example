# ==============================================================================
# LatentCraft Backend Environment Configuration
# ==============================================================================

# Database (Neon Serverless PostgreSQL in prod, or local SQLite fallback)
# Example Neon URL: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./latentcraft.db

# JWT Auth
JWT_SECRET_KEY=replace_with_a_strong_256_bit_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production HTTPS Cookie & CORS Settings
# For cross-domain Vercel + Render/Railway, set COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AWS S3 Cloud Storage
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-southeast-2
S3_ENDPOINT_URL=
S3_CUSTOM_DOMAIN=

# Serverless GPU Worker (Modal) - leave empty locally to use local CUDA GPU
GPU_WORKER_URL=
GPU_WORKER_SECRET=
